# The wildcard domain user projects live under: <slug>.$BASE_DOMAIN
# The apex (cicatrixa.com) is served by Vercel from site/ — this box owns app.* and *.
# deploy.sh refuses to deploy while these still hold a placeholder value.
BASE_DOMAIN=cicatrixa.com
BASE_URL=https://app.cicatrixa.com

# :80 behaviour. cx-to-https redirects to HTTPS (normal). Switch to cx-plain if
# Let's Encrypt ever fails to issue, so the site degrades to plain HTTP instead of
# redirecting every visitor to a port that cannot answer (which reads as a timeout).
HTTPS_REDIRECT_MW=cx-to-https

# OpenAI key powering the AI deploy engine (Dockerfile generation, failure
# diagnosis, smoke-test verdicts). Without it the engine falls back to heuristics.
OPENAI_API_KEY=
AI_MODEL=gpt-5.1-codex-mini

# Comma-separated emails that get admin on signup (first signup is always admin).
ADMIN_EMAILS=

# Host path of the self-heal demo's traefik dynamic dir (weighted canary files).
DEMO_DYNAMIC_DIR=/root/Cicatrixa/traefik/dynamic

# Per-user resource quotas (defaults; override per user from /admin).
# RAM_PER_CONTAINER_MB is the hard cgroup cap applied to every app container.
DEFAULT_QUOTA_SERVICES=5
DEFAULT_QUOTA_RAM_MB=2048
DEFAULT_QUOTA_DISK_MB=5120
RAM_PER_CONTAINER_MB=768
# Hard CPU cap per app container, in vCPUs (matches the $2.99 tier).
CPU_PER_CONTAINER=0.25

# Transactional email (signup verification, deploy-failure alerts) via Resend.
# Leave blank to disable — the platform works fine without it.
RESEND_API_KEY=
MAIL_FROM=Cicatrixa <noreply@cicatrixa.com>

# Stripe billing (subscription checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
