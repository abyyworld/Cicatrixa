# Required — OpenAI API key for the Diagnostician / Reproducer / Fixer
OPENAI_API_KEY=sk-...

# Optional — LLM model (default gpt-5.1; set to any model your key has access to)
# HEALER_MODEL=gpt-5.1

# Required — ABSOLUTE host path to the ./app directory.
# The healer bind-mounts it into ephemeral test containers, and bind mounts
# are resolved by the host Docker daemon, so it must be the HOST path.
# Example (note: quote it if the path contains spaces):
HOST_APP_SRC=/Users/you/path/to/yc S27/app

# Optional — human approval gate before deploying a verified patch:
#   off       = fully autonomous (default, best for the demo)
#   dashboard = one-click Approve/Reject button in the healer UI (localhost:9000)
#   telegram  = one-tap approve via Telegram bot (needs token + chat id below)
APPROVAL_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
