# The only required setting — OpenAI API key for the Diagnostician / Reproducer / Fixer
OPENAI_API_KEY=sk-...

# Optional — LLM model (default gpt-5.1)
# HEALER_MODEL=gpt-5.1

# Optional — human gate before deploying a verified patch:
#   off       = fully autonomous (default, best for the demo)
#   dashboard = one-click Approve/Reject button in the healer UI (localhost:9000)
# APPROVAL_MODE=off

# Traefik router the healer writes for the demo app. Default catches everything, which
# is right for a local run. On the shared production server set this to the demo's own
# hostname so it cannot swallow platform traffic:
#   DEMO_ROUTER_RULE=Host(`demo.cicatrixa.com`)
# DEMO_ROUTER_RULE=PathPrefix(`/`)
# DEMO_ROUTER_PRIORITY=1
